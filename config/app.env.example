## SQLite persistenz im Container
DB_PATH=/app/data/app.db

## BNP / Lightstreamer (Defaults)
LS_WSS_URL=wss://push.bnpparibas.com/lightstreamer
LS_ADAPTER_SET=SmarthouseFeed
LS_DATA_ADAPTER=MDS5
LS_ITEM_TEMPLATE=X0000010800{isin}
LS_ORIGIN=https://derivate.bnpparibas.com

# Optional: bei Problemen mit 400/Handshake
# LS_SUBPROTOCOL=TLCP-2.5.0.lightstreamer.com

# Reconnect/Stabilität (Defaults sind meist okay)
# Minimaler/Maximaler Backoff bei Reconnects
LS_RECONNECT_MIN_S=1
LS_RECONNECT_MAX_S=30
# WS receive timeout: wenn so lange *gar nichts* kommt, prüfen wir auf "stuck session"
LS_RECV_TIMEOUT_S=35
# Wenn wir insgesamt so lange keine WS-Messages sehen, wird die Session neu aufgebaut
LS_STALE_RESTART_S=90

## MQTT (Home Assistant)
# MQTT wird im Webinterface (Portfolio-Pflege) an/aus geschaltet (default: aus).
# Setze hier nur die Verbindungsdaten.
MQTT_HOST=
MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# Home Assistant Discovery
MQTT_DISCOVERY_PREFIX=homeassistant
MQTT_NODE_ID=portfolio_valuator
MQTT_OBJECT_ID=portfolio
MQTT_BASE_TOPIC=portfolio_valuator/portfolio_valuator
MQTT_QOS=0
MQTT_RETAIN=true
# 0 = jeder Push wird publiziert (mehr Historie in HA), >0 reduziert MQTT-Last
MQTT_DEBOUNCE_MS=0

## MQTT Sanity / Plausibility (gegen 0-Spikes & unplausible Statistik-Punkte)
# Preis-Sensoren (Position Kurs, Watchlist Kurs) nicht publizieren, wenn Preis 0.0 ist
MQTT_SANITY_SKIP_ZERO_PRICE=true
# Optional: Sprungfilter (in %). 0 deaktiviert. Beispiel: 50 = Änderungen >50% pro Push werden verworfen.
MQTT_SANITY_MAX_PCT_CHANGE=0
# Valuation-Sensoren (Wert/Performance) nur publizieren, wenn ein Kurs vorhanden ist
MQTT_SANITY_REQUIRE_PRICE_FOR_VALUATION=true
